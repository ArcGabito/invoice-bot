<?xml version="1.0" encoding="utf-8"?>
<!--
  Proyecto de Python para Visual Studio 2022/2026 (carga de trabajo "Desarrollo de Python").
  F5 inicia la API (invoicebot serve) con el entorno .venv; el Explorador de pruebas usa pytest.
  Crear el entorno: uv sync  (crea .venv con Python 3.13 y las dependencias de uv.lock, con el grupo dev)
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{4e7d22e1-3438-58a4-96bc-5eb516fb38eb}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <Name>InvoiceBot</Name>
    <RootNamespace>invoicebot</RootNamespace>
    <StartupFile>src\invoicebot\__main__.py</StartupFile>
    <CommandLineArguments>serve --open</CommandLineArguments>
    <SearchPath>src</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <LaunchProvider>Standard Python launcher</LaunchProvider>
    <InterpreterId>MSBuild|.venv|$(MSBuildProjectFullPath)</InterpreterId>
    <TestFramework>pytest</TestFramework>
    <UnitTestPattern>test_*.py</UnitTestPattern>
    <UnitTestRootDirectory>tests</UnitTestRootDirectory>
    <EnableNativeCodeDebugging>False</EnableNativeCodeDebugging>
    <IsWindowsApplication>False</IsWindowsApplication>
    <SuppressConfigureTestFrameworkPrompt>true</SuppressConfigureTestFrameworkPrompt>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\invoicebot\**\*.py" />
    <Compile Include="tests\**\*.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="src\invoicebot\api\templates\*.html" />
    <Content Include="src\invoicebot\api\static\*.*" />
    <Content Include="pyproject.toml" />
    <Content Include="uv.lock" />
    <Content Include=".python-version" />
    <Content Include="ROADMAP.md" />
    <Content Include=".env.example" />
    <Content Include="Dockerfile" />
    <Content Include="docker-compose.yml" />
    <Content Include="deploy\**\*.*" />
    <Content Include="docs\*.md" />
    <Content Include="scripts\**\*.ps1" />
    <Content Include=".github\workflows\*.yml" />
    <Content Include="README.md" />
    <Content Include="CHANGELOG.md" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include=".venv\">
      <Id>.venv</Id>
      <Version>3.13</Version>
      <Description>.venv (Python del proyecto)</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>
