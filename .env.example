# Copia este archivo como .env y ajusta los valores.
# Nunca subas tu .env a GitHub.

# Proveedor de IA: anthropic | ollama | mock
INVOICEBOT_AI_PROVIDER=anthropic

# Anthropic (Claude). Si ya usaste `ant auth login`, la clave no es necesaria.
ANTHROPIC_API_KEY=
INVOICEBOT_ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
INVOICEBOT_ANTHROPIC_EFFORT=medium

# Ollama (modelo local: los documentos no salen del equipo)
INVOICEBOT_OLLAMA_URL=http://127.0.0.1:11434
# Probado con qwen3.5:4b: ~10 s por factura en un equipo de escritorio.
INVOICEBOT_OLLAMA_MODEL=qwen3.5:4b
# Razonamiento previo del modelo: con true es mucho más lento y puede agotar
# el contexto antes de responder. Déjalo en false para extracción.
INVOICEBOT_OLLAMA_THINK=false
# Contexto en tokens (Ollama usa 4096 por defecto, que se queda corto).
INVOICEBOT_OLLAMA_NUM_CTX=8192
# Espera máxima por documento (milisegundos).
INVOICEBOT_OLLAMA_TIMEOUT_MS=600000

# Verificación en SUNAT (opcional). Desactivada por defecto: ninguna función
# consulta a SUNAT hasta que la actives aquí.
INVOICEBOT_SUNAT_ENABLED=false
# true: al terminar `scan`, verifica automáticamente las facturas pendientes.
# false: solo cuando ejecutes `invoicebot verify-sunat` (o `scan --verify-sunat`).
INVOICEBOT_SUNAT_VERIFY_ON_SCAN=false
# Credenciales: SUNAT Operaciones en Línea (Clave SOL) → Credenciales de API SUNAT.
# INVOICEBOT_SUNAT_RUC es el RUC de tu empresa, la que consulta.
INVOICEBOT_SUNAT_RUC=
INVOICEBOT_SUNAT_CLIENT_ID=
INVOICEBOT_SUNAT_CLIENT_SECRET=
# Espera máxima por consulta y pausa entre consultas (milisegundos).
INVOICEBOT_SUNAT_TIMEOUT_MS=20000
INVOICEBOT_SUNAT_DELAY_MS=0
# Solo si usas un proxy corporativo o un entorno de pruebas (vacío = URLs oficiales).
INVOICEBOT_SUNAT_AUTH_URL=
INVOICEBOT_SUNAT_API_URL=

# Rutas
INVOICEBOT_DATA_DIR=./data
INVOICEBOT_EXPORT_DIR=./exports
# csv | xlsx: formato por defecto de `invoicebot export`
INVOICEBOT_EXPORT_FORMAT=csv

# Ejecución desatendida (`invoicebot run`)
# Carpeta de entrada; puede ser una carpeta de OneDrive o SharePoint sincronizada.
INVOICEBOT_INBOX_DIR=
INVOICEBOT_INBOX_RECURSIVE=true
# none | csv | xlsx: exporta el mes actual y el anterior al terminar cada ciclo.
INVOICEBOT_RUN_EXPORT=none
# Minutos entre ciclos con `invoicebot run --watch`.
INVOICEBOT_RUN_INTERVAL_MINUTES=15

# Copias de seguridad (las hace `run` cuando toca, o `invoicebot backup`)
# Vacío = data/backups
INVOICEBOT_BACKUP_DIR=
INVOICEBOT_BACKUP_RETENTION=14
INVOICEBOT_BACKUP_INTERVAL_HOURS=24

# Logs en archivo, uno por día (vacío = solo en pantalla).
INVOICEBOT_LOG_DIR=./logs
INVOICEBOT_LOG_RETENTION_DAYS=30

# Procesamiento
INVOICEBOT_CONCURRENCY=2
INVOICEBOT_MAX_ATTEMPTS=3
INVOICEBOT_MIN_TEXT_CHARS=40
# Tolerancia aritmética en la moneda del comprobante (0.02 = 2 céntimos)
INVOICEBOT_AMOUNT_TOLERANCE=0.02

# trace | debug | info | warn | error | fatal | silent
INVOICEBOT_LOG_LEVEL=warn
