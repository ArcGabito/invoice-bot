# Copia este archivo como .env y ajusta los valores.
# Nunca subas tu .env a GitHub.

# Proveedor de IA: anthropic | ollama | mock
INVOICEBOT_AI_PROVIDER=anthropic

# Anthropic (Claude). Si ya usaste `ant auth login`, la clave no es necesaria.
ANTHROPIC_API_KEY=
INVOICEBOT_ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
INVOICEBOT_ANTHROPIC_EFFORT=medium

# Ollama (modelo local, para desarrollo: los documentos no salen del equipo).
# En producción usa anthropic: en una VM sin GPU, Ollama es muy lento.
INVOICEBOT_OLLAMA_URL=http://127.0.0.1:11434
# Probado con qwen3.5:4b: ~10 s por factura en un equipo de escritorio.
INVOICEBOT_OLLAMA_MODEL=qwen3.5:4b
# Razonamiento previo del modelo: con true es mucho más lento y puede agotar
# el contexto antes de responder. Déjalo en false para extracción.
INVOICEBOT_OLLAMA_THINK=false
# Contexto en tokens (Ollama usa 4096 por defecto, que se queda corto).
INVOICEBOT_OLLAMA_NUM_CTX=8192
# Espera máxima por documento (milisegundos).
INVOICEBOT_OLLAMA_TIMEOUT_MS=600000

# Verificación en SUNAT (opcional). Desactivada por defecto: ninguna función
# consulta a SUNAT hasta que la actives aquí.
INVOICEBOT_SUNAT_ENABLED=false
# true: al terminar `scan`, verifica automáticamente las facturas pendientes.
# false: solo cuando ejecutes `invoicebot verify-sunat` (o `scan --verify-sunat`).
INVOICEBOT_SUNAT_VERIFY_ON_SCAN=false
# Credenciales: SUNAT Operaciones en Línea (Clave SOL) → Credenciales de API SUNAT.
# INVOICEBOT_SUNAT_RUC es el RUC de tu empresa, la que consulta.
INVOICEBOT_SUNAT_RUC=
INVOICEBOT_SUNAT_CLIENT_ID=
INVOICEBOT_SUNAT_CLIENT_SECRET=
# Espera máxima por consulta y pausa entre consultas (milisegundos).
INVOICEBOT_SUNAT_TIMEOUT_MS=20000
INVOICEBOT_SUNAT_DELAY_MS=0
# Solo si usas un proxy corporativo o un entorno de pruebas (vacío = URLs oficiales).
INVOICEBOT_SUNAT_AUTH_URL=
INVOICEBOT_SUNAT_API_URL=

# Tipo de cambio del dólar (público, sin credenciales). `invoicebot run` descarga
# el del día de SUNAT para registrar en soles las facturas en dólares; las fechas
# anteriores se cargan con `invoicebot fx set` o `fx import`. false: solo manual.
INVOICEBOT_FX_SUNAT=true
INVOICEBOT_FX_TIMEOUT_MS=20000
# Solo si usas un proxy o un entorno de pruebas (vacío = archivo oficial de SUNAT).
INVOICEBOT_FX_SUNAT_URL=

# Lectura de comprobantes desde un buzón de correo (solo lectura: no borra,
# mueve ni marca mensajes). `invoicebot run` descarga los adjuntos XML, PDF,
# imágenes y ZIP de los correos nuevos y los procesa en el mismo ciclo.
#   none   desactivado
#   imap   Gmail con contraseña de aplicación, correo de hosting (cPanel,
#          Zimbra…), Zoho, Yahoo. Rellena USER, PASSWORD e IMAP_HOST.
#   gmail  API de Gmail: GOOGLE_CLIENT_ID/SECRET + `invoicebot mail login`,
#          o en Google Workspace una cuenta de servicio (GOOGLE_SERVICE_ACCOUNT_FILE + USER).
#   graph  Microsoft 365 / Outlook.com: MS_CLIENT_ID + `invoicebot mail login`,
#          o en Microsoft 365 permiso de aplicación (MS_TENANT + MS_CLIENT_SECRET + USER).
INVOICEBOT_MAIL_PROVIDER=none
# Dirección del buzón.
INVOICEBOT_MAIL_USER=
# IMAP: contraseña (en Gmail, contraseña de aplicación de 16 letras).
INVOICEBOT_MAIL_PASSWORD=
# IMAP: servidor (para @gmail.com se deduce solo), puerto y TLS directo.
INVOICEBOT_MAIL_IMAP_HOST=
INVOICEBOT_MAIL_IMAP_PORT=993
INVOICEBOT_MAIL_IMAP_TLS=true
# Carpeta (IMAP, Graph) o etiqueta (Gmail) a leer. Vacío = bandeja de entrada.
INVOICEBOT_MAIL_FOLDER=
# Días hacia atrás que se revisan en cada ciclo y máximo de mensajes por ciclo.
INVOICEBOT_MAIL_SINCE_DAYS=7
INVOICEBOT_MAIL_MAX_MESSAGES=200
INVOICEBOT_MAIL_TIMEOUT_MS=60000
# Dónde se guardan los adjuntos. Vacío = "correo" dentro de INVOICEBOT_INBOX_DIR.
INVOICEBOT_MAIL_DIR=
# Gmail (Google Cloud → Credenciales → ID de cliente OAuth "App de escritorio").
INVOICEBOT_MAIL_GOOGLE_CLIENT_ID=
INVOICEBOT_MAIL_GOOGLE_CLIENT_SECRET=
# Google Workspace: JSON de la cuenta de servicio con delegación de dominio (gmail.readonly).
INVOICEBOT_MAIL_GOOGLE_SERVICE_ACCOUNT_FILE=
# Microsoft (Entra ID → Registros de aplicaciones). common = cuentas personales y de empresa.
INVOICEBOT_MAIL_MS_TENANT=common
INVOICEBOT_MAIL_MS_CLIENT_ID=
# Solo para permiso de aplicación (Microsoft 365, sin inicio de sesión de usuario).
INVOICEBOT_MAIL_MS_CLIENT_SECRET=
# Alternativa a `invoicebot mail login`: refresh token obtenido en otro equipo.
INVOICEBOT_MAIL_REFRESH_TOKEN=

# Base de datos SQL Server (2019 o posterior; Express sirve)
# La base de datos y el usuario se crean con `invoicebot db init` (ver README).
INVOICEBOT_DB_SERVER=localhost
INVOICEBOT_DB_PORT=1433
INVOICEBOT_DB_NAME=invoicebot
INVOICEBOT_DB_USER=invoicebot_app
INVOICEBOT_DB_PASSWORD=
# Cifrado TLS de la conexión. TRUST_CERT=true acepta el certificado autofirmado
# de SQL Server: solo en este equipo o en una red de confianza.
INVOICEBOT_DB_ENCRYPT=true
INVOICEBOT_DB_TRUST_CERT=false
INVOICEBOT_DB_POOL_MAX=10
# Solo para `invoicebot db init` (una cuenta que pueda crear bases de datos e
# inicios de sesión, p. ej. sa). Bórralas al terminar.
INVOICEBOT_DB_ADMIN_USER=
INVOICEBOT_DB_ADMIN_PASSWORD=

# Docker Compose (solo si usas docker-compose.yml; guía: docs/instalacion-linux.md)
# Contraseña de sa del contenedor de SQL Server: 8+ caracteres con mayúsculas,
# minúsculas, números y símbolos. Los contenedores del bot no la reciben.
MSSQL_SA_PASSWORD=
# Express (gratis, hasta 10 GB) · Developer (solo desarrollo) · Standard/Enterprise (con licencia)
MSSQL_PID=Express
# Carpetas del equipo anfitrión que se montan en los contenedores.
INVOICEBOT_INBOX_HOST_DIR=./facturas
INVOICEBOT_EXPORT_HOST_DIR=./exports
INVOICEBOT_LOG_HOST_DIR=./logs
INVOICEBOT_TLS_HOST_DIR=./tls
# Dónde se publica la pantalla de revisión (puerto, o IP:puerto).
INVOICEBOT_SERVE_PUBLISH=4317

# Rutas
# Datos locales (OCR). Las facturas están en SQL Server.
INVOICEBOT_DATA_DIR=./data
INVOICEBOT_EXPORT_DIR=./exports
# csv | xlsx: formato por defecto de `invoicebot export`
INVOICEBOT_EXPORT_FORMAT=csv

# Ejecución desatendida (`invoicebot run`)
# Carpeta de entrada; puede ser una carpeta de OneDrive o SharePoint sincronizada.
INVOICEBOT_INBOX_DIR=
INVOICEBOT_INBOX_RECURSIVE=true
# none | csv | xlsx: exporta el mes actual y el anterior al terminar cada ciclo.
INVOICEBOT_RUN_EXPORT=none
# Minutos entre ciclos con `invoicebot run --watch`.
INVOICEBOT_RUN_INTERVAL_MINUTES=15

# Copias de seguridad (las hace `run` cuando toca, o `invoicebot backup`)
# Las escribe SQL Server con BACKUP DATABASE: es una ruta DEL SERVIDOR.
# Vacío = carpeta de copias por defecto de la instancia. Las copias antiguas
# solo se borran si InvoiceBot ve esa carpeta en la misma ruta.
INVOICEBOT_BACKUP_DIR=
INVOICEBOT_BACKUP_RETENTION=14
INVOICEBOT_BACKUP_INTERVAL_HOURS=24

# Pantalla de revisión (`invoicebot serve`)
INVOICEBOT_SERVE_PORT=4317
# 127.0.0.1: solo este equipo. 0.0.0.0: red de la oficina (VM o servidor); exige
# usuarios (`invoicebot user add`) y HTTPS. Guía: docs/instalacion-vm.md
INVOICEBOT_SERVE_HOST=127.0.0.1
# Certificado HTTPS: un .pfx (scripts/windows/new-review-certificate.ps1 crea uno)...
INVOICEBOT_SERVE_TLS_PFX=
# ...o un par PEM.
INVOICEBOT_SERVE_TLS_CERT=
INVOICEBOT_SERVE_TLS_KEY=
# Contraseña del .pfx o de la clave PEM.
INVOICEBOT_SERVE_TLS_PASSPHRASE=
# true solo si un proxy HTTPS de la empresa va delante (el tráfico hasta él va sin cifrar).
INVOICEBOT_SERVE_ALLOW_HTTP=false
# Horas que dura una sesión antes de volver a pedir la contraseña.
INVOICEBOT_SERVE_SESSION_HOURS=10
# Nombre que firma las revisiones (vacío = usuario de Windows).
INVOICEBOT_USER=

# Logs en archivo, uno por día (vacío = solo en pantalla).
INVOICEBOT_LOG_DIR=./logs
INVOICEBOT_LOG_RETENTION_DAYS=30

# OCR para PDF escaneados y fotos
# tesseract: local, sin internet (por defecto)
# claude: visión de Claude; el documento completo sale del equipo hacia Anthropic
# none: sin OCR (los escaneos quedan en needs_ocr)
INVOICEBOT_OCR_ENGINE=tesseract
# Idiomas de Tesseract; spa y eng vienen instalados. Otros: npm install @tesseract.js-data/<código>
INVOICEBOT_OCR_LANGUAGES=spa,eng
# Páginas leídas de cada PDF escaneado y escala de dibujo (3 ≈ 216 ppp).
INVOICEBOT_OCR_MAX_PAGES=3
INVOICEBOT_OCR_SCALE=3
# Por debajo de esta confianza (0-100) la factura queda con advertencia para revisión.
INVOICEBOT_OCR_MIN_CONFIDENCE=70

# Procesamiento
INVOICEBOT_CONCURRENCY=2
INVOICEBOT_MAX_ATTEMPTS=3
INVOICEBOT_MIN_TEXT_CHARS=40
# Tolerancia aritmética en la moneda del comprobante (0.02 = 2 céntimos)
INVOICEBOT_AMOUNT_TOLERANCE=0.02

# trace | debug | info | warn | error | fatal | silent
INVOICEBOT_LOG_LEVEL=warn
