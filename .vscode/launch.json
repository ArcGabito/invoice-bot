{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "invoicebot scan (mock)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/cli/bin.ts",
      "args": ["--provider", "mock", "scan", "./facturas"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "invoicebot doctor",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/cli/bin.ts",
      "args": ["doctor"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Vitest",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
