# Dependencias
node_modules/

# Secretos y configuración local
.env
.env.*
!.env.example

# Datos del usuario: base de datos, facturas, exportaciones y logs.
# Anclados a la raíz con "/" para no ocultar carpetas de código como
# src/infrastructure/exports/.
/data/
/exports/
/facturas/
/facturas-demo/
/invoices/
/logs/
*.db
*.db-shm
*.db-wal
*.log

# Documentos que nunca deben subirse (las pruebas generan los suyos en temporales)
*.pdf
*.png
*.jpg
*.jpeg

# Cobertura y herramientas
coverage/
.vs/
*.user
.DS_Store
Thumbs.db

# Artefactos de compilación de Visual Studio
obj/
