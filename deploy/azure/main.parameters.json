{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "name": { "value": "invoicebot" },
    "image": { "value": "ghcr.io/arcgabito/invoice-bot:latest" },
    "mode": { "value": "queue" },
    "schedulerCron": { "value": "*/2 * * * *" },
    "deployRedis": { "value": true },
    "redisSku": { "value": "Balanced_B0" },
    "workerMaxReplicas": { "value": 5 },
    "apiMinReplicas": { "value": 1 },
    "deploySql": { "value": true },
    "aiProvider": { "value": "anthropic" },
    "extraEnv": {
      "value": [
        { "name": "INVOICEBOT_RUN_EXPORT", "value": "xlsx" },
        { "name": "INVOICEBOT_FX_SUNAT", "value": "true" },
        { "name": "INVOICEBOT_MAIL_PROVIDER", "value": "none" },
        { "name": "INVOICEBOT_SUNAT_ENABLED", "value": "false" }
      ]
    }
  }
}
